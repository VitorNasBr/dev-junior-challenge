# Copy this file to .env and adjust if needed.

# Port the API listens on
PORT=3000

# Origin of the web app (used for CORS)
WEB_ORIGIN=http://localhost:5173

# External patient registry (mock-service)
PATIENT_REGISTRY_URL=http://localhost:4000

# PostgreSQL connection (matches the "db" service in docker-compose.yml)
DATABASE_URL=postgresql://desafio:desafio@localhost:5432/checkin
